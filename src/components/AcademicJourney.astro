---
import { getCollection } from 'astro:content';

const academicEntries = await getCollection('academic');
const sortedAcademic = academicEntries.sort((a, b) => a.data.order - b.data.order);
---

<section id="academic" class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <!-- VS Code Workstation Outer Container (Double-Bezel) -->
  <div class="w-full rounded-2xl bg-black/80 border border-emerald-500/30 p-2 shadow-[0_0_80px_rgba(16,185,129,0.12)] backdrop-blur-xl">
    
    <!-- VS Code Inner Editor Frame -->
    <div class="w-full rounded-xl bg-[#0b0c13]/95 border border-emerald-500/20 overflow-hidden font-mono">
      
      <!-- Window Title Bar -->
      <div class="px-4 py-2 bg-[#121420] border-b border-emerald-500/20 flex items-center justify-between text-xs text-emerald-300/80">
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5 mr-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
          </div>
          <span class="font-bold text-amber-400">⚙️ 02_academic_journey.json</span>
          <span class="text-[10px] text-emerald-500/60">— workspace/data</span>
        </div>

        <div class="hidden sm:flex items-center gap-4 text-[11px] text-emerald-400/60">
          <span>JSON Schema</span>
          <span>UTF-8</span>
          <span> main*</span>
        </div>
      </div>

      <!-- File Tabs Header -->
      <div class="flex items-center gap-1 px-3 pt-2 bg-[#0e101a] border-b border-emerald-500/20 text-xs overflow-x-auto">
        <a href="#hero" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2">
          <span class="text-emerald-400">📝</span> 01_origin_story.md
        </a>
        <div class="px-3 py-1.5 rounded-t bg-[#0b0c13] border-t-2 border-amber-400 text-amber-300 font-bold flex items-center gap-2">
          <span>⚙️</span> 02_academic_journey.json <span class="text-[10px] opacity-60">✕</span>
        </div>
        <a href="#skill-studio" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2">
          <span class="text-blue-400">⚡</span> 04_skill_studio.cpp
        </a>
      </div>

      <!-- Section Title Inside IDE Comment -->
      <div class="p-6 pb-2 text-center sm:text-left border-b border-emerald-500/10 bg-[#0c0d16]">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1 flex items-center gap-2 justify-center sm:justify-start" data-i18n="section_acad_title">
          <span class="text-amber-400">//</span> 🎓 Academic Journey & Project Research
        </h2>
        <p class="text-xs sm:text-sm text-emerald-400/70" data-i18n="section_acad_subtitle">
          From STEM foundation to Diploma Full-Stack Team Lead and Degree AI breakthroughs
        </p>
      </div>

      <!-- JSON Code Editor Body with Line Numbers -->
      <div class="p-4 sm:p-8 flex gap-3 sm:gap-6 text-left">
        <!-- Line Numbers Column -->
        <div class="select-none text-emerald-500/30 text-xs sm:text-sm font-mono space-y-4 pt-1 text-right w-6 sm:w-8 flex-shrink-0">
          <div>01</div>
          <div>02</div>
          <div>03</div>
          <div>04</div>
          <div>05</div>
          <div>06</div>
          <div>07</div>
          <div>08</div>
          <div>09</div>
        </div>

        <!-- Academic JSON Cards Container -->
        <div class="flex-1 space-y-6">
          <div class="text-amber-300/80 font-bold text-xs sm:text-sm">{"{"} <span class="text-emerald-400">"academic_journey"</span>: [</div>

          {sortedAcademic.map(async (entry, index) => {
            const { Content } = await entry.render();
            return (
              <div class="pl-4 sm:pl-6 border-l-2 border-emerald-500/30 space-y-3 relative group">
                <!-- JSON Object Header -->
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
                  <span class="text-emerald-400 font-bold">
                    {"{"} <span class="text-emerald-200">"period"</span>: <span class="text-amber-300">"{entry.data.period}"</span>,
                  </span>
                  {entry.data.cgpa && (
                    <span class="px-2.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px]">
                      "cgpa": <strong class="text-amber-300">"{entry.data.cgpa}"</strong>
                    </span>
                  )}
                </div>

                <!-- Course Title & Institution -->
                <div class="pl-2">
                  <div class="text-base sm:text-lg font-bold text-white mb-0.5">
                    "title": <span class="text-emerald-300">"{entry.data.title}"</span>
                  </div>
                  <div class="text-xs sm:text-sm text-emerald-400/80">
                    "institution": <span class="text-teal-200">"{entry.data.institution}"</span>
                  </div>
                </div>
                
                <!-- Description Body -->
                <div class="pl-2 text-xs sm:text-sm text-emerald-200/90 leading-relaxed font-sans bg-black/40 p-3 rounded-lg border border-emerald-500/20">
                  <Content />
                </div>

                <!-- Key Project Sub-JSON -->
                {entry.data.fypTitle && (
                  <div class="pl-2 mt-2 p-3 rounded-lg bg-emerald-950/50 border border-emerald-500/30 font-mono text-xs">
                    <div class="font-bold text-amber-300 mb-1">
                      "featured_project": <span class="text-emerald-400">"{entry.data.fypTitle}"</span>
                    </div>
                    <div class="text-emerald-200/80 text-[11px] leading-relaxed">
                      "highlights": "{entry.data.fypDesc}"
                    </div>
                  </div>
                )}

                <div class="text-amber-300/60 font-bold text-xs">
                  {"}"}{index < sortedAcademic.length - 1 ? ',' : ''}
                </div>
              </div>
            );
          })}

          <div class="text-amber-300/80 font-bold text-xs sm:text-sm">] {"}"}</div>
        </div>
      </div>
    </div>
  </div>
</section>
