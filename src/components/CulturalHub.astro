---
---

<section id="culture" class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <!-- VS Code Workstation Outer Container (Double-Bezel) -->
  <div class="w-full rounded-2xl bg-black/80 border border-emerald-500/30 p-2 shadow-[0_0_80px_rgba(16,185,129,0.12)] backdrop-blur-xl">
    
    <!-- VS Code Inner Editor Frame -->
    <div class="w-full rounded-xl bg-[#0b0c13]/95 border border-emerald-500/20 overflow-hidden font-mono">
      
      <!-- Window Title Bar -->
      <div class="px-4 py-2 bg-[#121420] border-b border-emerald-500/20 flex items-center justify-between text-xs text-emerald-300/80">
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5 mr-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
          </div>
          <span class="font-bold text-teal-400">📄 03_culture_hub.config</span>
          <span class="text-[10px] text-emerald-500/60">— workspace/config</span>
        </div>

        <div class="hidden sm:flex items-center gap-4 text-[11px] text-emerald-400/60">
          <span>Config Spec</span>
          <span>UTF-8</span>
          <span> main*</span>
        </div>
      </div>

      <!-- COMPLETE 6-FILE WORKSPACE TABS HEADER -->
      <div class="flex items-center gap-1 px-3 pt-2 bg-[#0e101a] border-b border-emerald-500/20 text-xs overflow-x-auto">
        <a href="#hero" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2 flex-shrink-0">
          <span class="text-emerald-400">📝</span> 01_origin_story.md
        </a>
        <a href="#academic" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2 flex-shrink-0">
          <span class="text-amber-400">⚙️</span> 02_academic_journey.json
        </a>
        <div class="px-3 py-1.5 rounded-t bg-[#0b0c13] border-t-2 border-teal-400 text-teal-300 font-bold flex items-center gap-2 flex-shrink-0">
          <span>✨</span> 03_culture_hub.config <span class="text-[10px] opacity-60">✕</span>
        </div>
        <a href="#skill-studio" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2 flex-shrink-0">
          <span class="text-blue-400">⚡</span> 04_skill_studio.cpp
        </a>
        <a href="#n8n-studio" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2 flex-shrink-0">
          <span class="text-purple-400">🤖</span> 05_n8n_workflow.py
        </a>
        <a href="#micro-tools" class="px-3 py-1.5 rounded-t text-emerald-300/60 hover:bg-[#121420] transition flex items-center gap-2 flex-shrink-0">
          <span class="text-emerald-400">🛠️</span> 06_micro_tools.css
        </a>
      </div>

      <!-- Section Header -->
      <div class="p-6 pb-2 text-center sm:text-left border-b border-emerald-500/10 bg-[#0c0d16]">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1 flex items-center gap-2 justify-center sm:justify-start" data-i18n="section_cult_title">
          <span class="text-teal-400">//</span> ✨ Cultural Tastes & Inspirations
        </h2>
        <p class="text-xs sm:text-sm text-emerald-400/70" data-i18n="section_cult_subtitle">
          Inspirations beyond code: Football tactics, R&B Groove, Sci-Fi, and competitive gaming
        </p>
      </div>

      <!-- Editor Content Body -->
      <div class="p-4 sm:p-8 flex gap-3 sm:gap-6 text-left">
        <!-- Line Numbers Column -->
        <div class="select-none text-emerald-500/30 text-xs sm:text-sm font-mono space-y-4 pt-1 text-right w-6 sm:w-8 flex-shrink-0">
          <div>01</div>
          <div>02</div>
          <div>03</div>
          <div>04</div>
          <div>05</div>
          <div>06</div>
        </div>

        <!-- Content Grid -->
        <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Football Pitch Card -->
          <div class="p-5 rounded-xl bg-black/60 border border-emerald-500/30 backdrop-blur-md relative group hover:border-emerald-500/60 transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl p-2 rounded-lg bg-emerald-950/80 border border-emerald-500/30">⚽</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-white font-mono" data-i18n="cult_football_title">Football Pitch (Favorite Clubs)</h3>
                <span class="text-[11px] text-emerald-400/60">Tactical Precision & High Press</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-emerald-200/80 mb-5 leading-relaxed font-sans" data-i18n="cult_football_desc">
              Passionate about tactical precision, fluid passing, and execution excellence on the pitch — just like writing high-performance code.
            </p>

            <!-- Club Crest Badges -->
            <div class="space-y-2.5 font-mono text-xs">
              <!-- BVB -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-[#fde100]/10 border border-[#fde100]/30 text-[#fde100]">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-[#fde100] text-black font-extrabold flex items-center justify-center text-[10px] shadow-md border border-black/40">
                    BVB
                  </div>
                  <div>
                    <span class="font-bold block">Borussia Dortmund</span>
                    <span class="text-[10px] text-amber-200/70">Bundesliga · Signal Iduna Park</span>
                  </div>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#fde100]/20 font-semibold">09</span>
              </div>

              <!-- Arsenal -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-[#ef0107]/10 border border-[#ef0107]/30 text-red-300">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-[#ef0107] text-white font-extrabold flex items-center justify-center text-[11px] shadow-md border border-red-400/40">
                    🚀
                  </div>
                  <div>
                    <span class="font-bold block">Arsenal FC (Gunners)</span>
                    <span class="text-[10px] text-red-300/70">Premier League · Emirates</span>
                  </div>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#ef0107]/20 font-semibold">AFC</span>
              </div>

              <!-- Man City -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-[#6cabdd]/10 border border-[#6cabdd]/30 text-cyan-300">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-[#6cabdd] text-black font-extrabold flex items-center justify-center text-[11px] shadow-md border border-cyan-400/40">
                    ⚽
                  </div>
                  <div>
                    <span class="font-bold block">Manchester City</span>
                    <span class="text-[10px] text-cyan-200/70">Premier League · Etihad</span>
                  </div>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#6cabdd]/20 font-semibold">MCFC</span>
              </div>
            </div>
          </div>

          <!-- Music Artists Card -->
          <div class="p-5 rounded-xl bg-black/60 border border-emerald-500/30 backdrop-blur-md relative group hover:border-emerald-500/60 transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl p-2 rounded-lg bg-emerald-950/80 border border-emerald-500/30">🎵</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-white font-mono" data-i18n="cult_music_title">Music Groove (R&B & Soul)</h3>
                <span class="text-[11px] text-purple-400/60">Rich Harmonies & Retro Groove</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-emerald-200/80 mb-5 leading-relaxed font-sans" data-i18n="cult_music_desc">
              Enthusiast of R&B, Soul, and Funk music by Khalil Fong, David Tao, and Bruno Mars. Rich harmonies drive coding focus.
            </p>

            <!-- Artist Vinyl Badges -->
            <div class="space-y-2.5 font-mono text-xs">
              <!-- Khalil Fong -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-purple-950/50 border border-purple-500/30 text-purple-300">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-purple-900 text-purple-200 font-extrabold flex items-center justify-center text-xs animate-spin-slow shadow-md border border-purple-400/40">
                    📻
                  </div>
                  <div>
                    <span class="font-bold block">Khalil Fong (方大同)</span>
                    <span class="text-[10px] text-purple-300/70">Mandarin R&B · Soulboy</span>
                  </div>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-purple-500/20 font-semibold">SOUL</span>
              </div>

              <!-- David Tao -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-blue-950/50 border border-blue-500/30 text-blue-300">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-blue-900 text-blue-200 font-extrabold flex items-center justify-center text-xs shadow-md border border-blue-400/40">
                    🎙️
                  </div>
                  <div>
                    <span class="font-bold block">David Tao (陶喆)</span>
                    <span class="text-[10px] text-blue-300/70">R&B Godfather · Classic Harmonies</span>
                  </div>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-blue-500/20 font-semibold">R&B</span>
              </div>

              <!-- Bruno Mars -->
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-amber-950/50 border border-amber-500/30 text-amber-300">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-amber-900 text-amber-200 font-extrabold flex items-center justify-center text-xs shadow-md border border-amber-400/40">
                    🎷
                  </div>
                  <div>
                    <span class="font-bold block">Bruno Mars</span>
                    <span class="text-[10px] text-amber-300/70">Funk & Soul · 24K Magic</span>
                  </div>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/20 font-semibold">FUNK</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
