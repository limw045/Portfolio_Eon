---
import WorkspacePanel from './WorkspacePanel.astro';
import { workspaceFiles } from '../data/workspace';
const file = workspaceFiles[2];
---

<section id="culture" class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <WorkspacePanel file={file}>

      <!-- Section Header -->
      <div class="p-6 pb-2 text-center sm:text-left border-b border-emerald-500/10 bg-[#0c0d16]">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1 flex items-center gap-2 justify-center sm:justify-start" data-i18n="section_cult_title">
          <span class="text-teal-400">//</span> ✨ Cultural Tastes & Inspirations
        </h2>
        <p class="text-xs sm:text-sm text-emerald-400/70" data-i18n="section_cult_subtitle">
          Inspirations beyond code: Football tactics, R&B Groove, Sci-Fi, and competitive gaming
        </p>
      </div>

      <!-- Editor Content Body -->
      <div class="p-4 sm:p-8 flex gap-3 sm:gap-6 text-left">
        <!-- Line Numbers Column -->
        <div class="select-none text-emerald-500/30 text-xs sm:text-sm font-mono space-y-4 pt-1 text-right w-6 sm:w-8 flex-shrink-0">
          <div>01</div>
          <div>02</div>
          <div>03</div>
          <div>04</div>
          <div>05</div>
          <div>06</div>
        </div>

        <!-- Content Grid -->
        <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Football Pitch Card (With Star Player Photos on Hover) -->
          <div class="p-5 rounded-xl bg-black/60 border border-emerald-500/30 backdrop-blur-md relative group hover:border-emerald-500/60 transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl p-2 rounded-lg bg-emerald-950/80 border border-emerald-500/30">⚽</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-white font-mono" data-i18n="cult_football_title">Football Pitch (Favorite Clubs)</h3>
                <span class="text-[11px] text-emerald-400/60">Hover club cards to view star player photos</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-emerald-200/80 mb-5 leading-relaxed font-sans" data-i18n="cult_football_desc">
              Passionate about tactical precision, fluid passing, and execution excellence on the pitch — just like writing high-performance code.
            </p>

            <!-- Club Crest Badges with Star Player Photo Avatars -->
            <div class="space-y-3 font-mono text-xs">
              
              <!-- BVB Dortmund -->
              <div class="group/bvb relative p-3 rounded-xl bg-[#fde100]/10 border border-[#fde100]/30 text-[#fde100] hover:border-[#fde100]/80 transition cursor-pointer">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-[#fde100] text-black font-extrabold flex items-center justify-center text-[11px] shadow-md border border-black/40">
                      BVB
                    </div>
                    <div>
                      <span class="font-bold block text-sm">Borussia Dortmund</span>
                      <span class="text-[11px] text-amber-200/70">Bundesliga · Signal Iduna Park</span>
                    </div>
                  </div>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-[#fde100]/20 font-bold">09</span>
                </div>

                <!-- Hover Star Player Photos Panel -->
                <div class="mt-3 pt-3 border-t border-[#fde100]/20 hidden group-hover/bvb:block animate-fade-in space-y-2">
                  <span class="font-bold text-[#fde100] text-[11px] flex items-center gap-1">
                    <span>⭐</span> Star Player Icons:
                  </span>
                  <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="p-1.5 rounded-lg bg-black/60 border border-[#fde100]/30 flex flex-col items-center">
                      <img src="/images/players/bellingham.jpg" alt="Jude Bellingham" class="w-10 h-10 rounded-full object-cover border border-[#fde100]/60 mb-1" />
                      <span class="text-[10px] text-amber-200 font-bold leading-tight">J. Bellingham</span>
                    </div>
                    <div class="p-1.5 rounded-lg bg-black/60 border border-[#fde100]/30 flex flex-col items-center">
                      <img src="/images/players/haaland.jpg" alt="Erling Haaland" class="w-10 h-10 rounded-full object-cover border border-[#fde100]/60 mb-1" />
                      <span class="text-[10px] text-amber-200 font-bold leading-tight">E. Haaland</span>
                    </div>
                    <div class="p-1.5 rounded-lg bg-black/60 border border-[#fde100]/30 flex flex-col items-center">
                      <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-[#fde100]/60 flex items-center justify-center font-bold text-amber-300 text-xs mb-1">MR</div>
                      <span class="text-[10px] text-amber-200 font-bold leading-tight">Marco Reus</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Arsenal FC -->
              <div class="group/gunners relative p-3 rounded-xl bg-[#ef0107]/10 border border-[#ef0107]/30 text-red-300 hover:border-[#ef0107]/80 transition cursor-pointer">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-[#ef0107] text-white font-extrabold flex items-center justify-center text-xs shadow-md border border-red-400/40">
                      🚀
                    </div>
                    <div>
                      <span class="font-bold block text-sm text-white">Arsenal FC (Gunners)</span>
                      <span class="text-[11px] text-red-300/70">Premier League · Emirates</span>
                    </div>
                  </div>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-[#ef0107]/20 font-bold">AFC</span>
                </div>

                <!-- Hover Star Player Photos Panel -->
                <div class="mt-3 pt-3 border-t border-[#ef0107]/20 hidden group-hover/gunners:block animate-fade-in space-y-2">
                  <span class="font-bold text-red-400 text-[11px] flex items-center gap-1">
                    <span>⭐</span> Star Player Icons:
                  </span>
                  <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="p-1.5 rounded-lg bg-black/60 border border-red-500/30 flex flex-col items-center">
                      <img src="/images/players/saka.jpg" alt="Bukayo Saka" class="w-10 h-10 rounded-full object-cover border border-red-400/60 mb-1" />
                      <span class="text-[10px] text-red-200 font-bold leading-tight">Bukayo Saka</span>
                    </div>
                    <div class="p-1.5 rounded-lg bg-black/60 border border-red-500/30 flex flex-col items-center">
                      <div class="w-10 h-10 rounded-full bg-red-500/20 border border-red-400/60 flex items-center justify-center font-bold text-red-300 text-xs mb-1">DR</div>
                      <span class="text-[10px] text-red-200 font-bold leading-tight">Declan Rice</span>
                    </div>
                    <div class="p-1.5 rounded-lg bg-black/60 border border-red-500/30 flex flex-col items-center">
                      <div class="w-10 h-10 rounded-full bg-red-500/20 border border-red-400/60 flex items-center justify-center font-bold text-red-300 text-xs mb-1">MØ</div>
                      <span class="text-[10px] text-red-200 font-bold leading-tight">M. Ødegaard</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Manchester City -->
              <div class="group/mcfc relative p-3 rounded-xl bg-[#6cabdd]/10 border border-[#6cabdd]/30 text-cyan-300 hover:border-[#6cabdd]/80 transition cursor-pointer">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-[#6cabdd] text-black font-extrabold flex items-center justify-center text-xs shadow-md border border-cyan-400/40">
                      ⚽
                    </div>
                    <div>
                      <span class="font-bold block text-sm text-white">Manchester City</span>
                      <span class="text-[11px] text-cyan-200/70">Premier League · Etihad</span>
                    </div>
                  </div>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-[#6cabdd]/20 font-bold">MCFC</span>
                </div>

                <!-- Hover Star Player Photos Panel -->
                <div class="mt-3 pt-3 border-t border-[#6cabdd]/20 hidden group-hover/mcfc:block animate-fade-in space-y-2">
                  <span class="font-bold text-cyan-400 text-[11px] flex items-center gap-1">
                    <span>⭐</span> Star Player Icons:
                  </span>
                  <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="p-1.5 rounded-lg bg-black/60 border border-cyan-500/30 flex flex-col items-center">
                      <img src="/images/players/debruyne.jpg" alt="Kevin De Bruyne" class="w-10 h-10 rounded-full object-cover border border-cyan-400/60 mb-1" />
                      <span class="text-[10px] text-cyan-200 font-bold leading-tight">K. De Bruyne</span>
                    </div>
                    <div class="p-1.5 rounded-lg bg-black/60 border border-cyan-500/30 flex flex-col items-center">
                      <img src="/images/players/haaland.jpg" alt="Erling Haaland" class="w-10 h-10 rounded-full object-cover border border-cyan-400/60 mb-1" />
                      <span class="text-[10px] text-cyan-200 font-bold leading-tight">E. Haaland</span>
                    </div>
                    <div class="p-1.5 rounded-lg bg-black/60 border border-cyan-500/30 flex flex-col items-center">
                      <div class="w-10 h-10 rounded-full bg-cyan-500/20 border border-cyan-400/60 flex items-center justify-center font-bold text-cyan-300 text-xs mb-1">EH</div>
                      <span class="text-[10px] text-cyan-200 font-bold leading-tight">Eden Hazard</span>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Music Artists Card with Resilient In-Browser Audio Stream & YouTube Link Option -->
          <div class="p-5 rounded-xl bg-black/60 border border-emerald-500/30 backdrop-blur-md relative group hover:border-emerald-500/60 transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl p-2 rounded-lg bg-emerald-950/80 border border-emerald-500/30">🎵</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-white font-mono" data-i18n="cult_music_title">Music Groove (R&B & Soul)</h3>
                <span class="text-[11px] text-purple-400/60">Click artist cards to view & stream songs</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-emerald-200/80 mb-5 leading-relaxed font-sans" data-i18n="cult_music_desc">
              Enthusiast of R&B, Soul, and Funk music by Khalil Fong, David Tao, and Bruno Mars. Rich harmonies drive coding focus.
            </p>

            <!-- Artist Vinyl Cards -->
            <div class="space-y-3 font-mono text-xs">
              
              <!-- 1. Khalil Fong (方大同) -->
              <div class="p-3 rounded-xl bg-purple-950/50 border border-purple-500/30 text-purple-300 hover:border-purple-400 transition cursor-pointer music-artist-card" data-target="khalil">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-purple-900 text-purple-200 font-extrabold flex items-center justify-center text-sm shadow-md border border-purple-400/40">
                      📻
                    </div>
                    <div>
                      <span class="font-bold block text-sm text-white">Khalil Fong (方大同)</span>
                      <span class="text-[11px] text-purple-300/70">Mandarin R&B · Soulboy</span>
                    </div>
                  </div>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-purple-500/20 font-bold flex items-center gap-1">
                    🎵 Song Tracklist ▾
                  </span>
                </div>

                <!-- Playable Tracklist Drawer -->
                <div id="playlist-khalil" class="mt-3 pt-3 border-t border-purple-500/20 hidden space-y-2">
                  <div class="text-[10px] text-purple-400 uppercase tracking-wider font-bold">🎵 Featured Tracks:</div>
                  
                  <div class="flex items-center justify-between p-2 rounded bg-purple-900/40 text-purple-200">
                    <span>1. 《爱爱爱》 (Love Love Love)</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-purple-500/30 text-purple-300 hover:bg-purple-500/50 transition font-bold" data-video="Gz8LzN6BwA8" data-search="方大同 爱爱爱" data-title="方大同 - 爱爱爱">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=方大同+爱爱爱" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-purple-950 border border-purple-500/40 text-purple-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-2 rounded bg-purple-900/40 text-purple-200">
                    <span>2. 《三人游》 (Three of Us)</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-purple-500/30 text-purple-300 hover:bg-purple-500/50 transition font-bold" data-video="U6qPvhgGj8w" data-search="方大同 三人游" data-title="方大同 - 三人游">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=方大同+三人游" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-purple-950 border border-purple-500/40 text-purple-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-2 rounded bg-purple-900/40 text-purple-200">
                    <span>3. 《特别的人》 (Special Person)</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-purple-500/30 text-purple-300 hover:bg-purple-500/50 transition font-bold" data-video="lU63q5-M5XU" data-search="方大同 特别的人" data-title="方大同 - 特别的人">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=方大同+特别的人" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-purple-950 border border-purple-500/40 text-purple-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 2. David Tao (陶喆) -->
              <div class="p-3 rounded-xl bg-blue-950/50 border border-blue-500/30 text-blue-300 hover:border-blue-400 transition cursor-pointer music-artist-card" data-target="david">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-blue-900 text-blue-200 font-extrabold flex items-center justify-center text-sm shadow-md border border-blue-400/40">
                      🎙️
                    </div>
                    <div>
                      <span class="font-bold block text-sm text-white">David Tao (陶喆)</span>
                      <span class="text-[11px] text-blue-300/70">R&B Godfather · Classic Harmonies</span>
                    </div>
                  </div>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-blue-500/20 font-bold flex items-center gap-1">
                    🎵 Song Tracklist ▾
                  </span>
                </div>

                <!-- Playable Tracklist Drawer -->
                <div id="playlist-david" class="mt-3 pt-3 border-t border-blue-500/20 hidden space-y-2">
                  <div class="text-[10px] text-blue-400 uppercase tracking-wider font-bold">🎵 Featured Tracks:</div>
                  
                  <div class="flex items-center justify-between p-2 rounded bg-blue-900/40 text-blue-200">
                    <span>1. 《爱很简单》 (I Love You)</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-blue-500/30 text-blue-300 hover:bg-blue-500/50 transition font-bold" data-video="Q302f8uHhF0" data-search="陶喆 爱很简单" data-title="陶喆 - 爱很简单">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=陶喆+爱很简单" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-blue-950 border border-blue-500/40 text-blue-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-2 rounded bg-blue-900/40 text-blue-200">
                    <span>2. 《普通朋友》 (Regular Friends)</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-blue-500/30 text-blue-300 hover:bg-blue-500/50 transition font-bold" data-video="XQ9_08p3F2Q" data-search="陶喆 普通朋友" data-title="陶喆 - 普通朋友">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=陶喆+普通朋友" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-blue-950 border border-blue-500/40 text-blue-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-2 rounded bg-blue-900/40 text-blue-200">
                    <span>3. 《黑色柳丁》 (Black Tangerine)</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-blue-500/30 text-blue-300 hover:bg-blue-500/50 transition font-bold" data-video="JzV-0_x9X9g" data-search="陶喆 黑色柳丁" data-title="陶喆 - 黑色柳丁">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=陶喆+黑色柳丁" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-blue-950 border border-blue-500/40 text-blue-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 3. Bruno Mars -->
              <div class="p-3 rounded-xl bg-amber-950/50 border border-amber-500/30 text-amber-300 hover:border-amber-400 transition cursor-pointer music-artist-card" data-target="bruno">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-amber-900 text-amber-200 font-extrabold flex items-center justify-center text-sm shadow-md border border-amber-400/40">
                      🎷
                    </div>
                    <div>
                      <span class="font-bold block text-sm text-white">Bruno Mars</span>
                      <span class="text-[11px] text-amber-300/70">Funk & Soul · 24K Magic</span>
                    </div>
                  </div>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-amber-500/20 font-bold flex items-center gap-1">
                    🎵 Song Tracklist ▾
                  </span>
                </div>

                <!-- Playable Tracklist Drawer -->
                <div id="playlist-bruno" class="mt-3 pt-3 border-t border-amber-500/20 hidden space-y-2">
                  <div class="text-[10px] text-amber-400 uppercase tracking-wider font-bold">🎵 Featured Tracks:</div>
                  
                  <div class="flex items-center justify-between p-2 rounded bg-amber-900/40 text-amber-200">
                    <span>1. Leave The Door Open</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-amber-500/30 text-amber-300 hover:bg-amber-500/50 transition font-bold" data-video="adLGH7J3bmM" data-search="Bruno Mars Leave The Door Open" data-title="Bruno Mars - Leave The Door Open">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=Bruno+Mars+Leave+The+Door+Open" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-amber-950 border border-amber-500/40 text-amber-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-2 rounded bg-amber-900/40 text-amber-200">
                    <span>2. 24K Magic</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-amber-500/30 text-amber-300 hover:bg-amber-500/50 transition font-bold" data-video="UqyT8IEBkvY" data-search="Bruno Mars 24K Magic" data-title="Bruno Mars - 24K Magic">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=Bruno+Mars+24K+Magic" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-amber-950 border border-amber-500/40 text-amber-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-2 rounded bg-amber-900/40 text-amber-200">
                    <span>3. Uptown Funk</span>
                    <div class="flex items-center gap-2">
                      <button class="play-track-btn px-2 py-0.5 rounded bg-amber-500/30 text-amber-300 hover:bg-amber-500/50 transition font-bold" data-video="OPf0YbXqDm0" data-search="Bruno Mars Uptown Funk" data-title="Bruno Mars - Uptown Funk">▶ Play Embed</button>
                      <a href="https://music.youtube.com/search?q=Bruno+Mars+Uptown+Funk" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-amber-950 border border-amber-500/40 text-amber-300 hover:text-white transition text-[10px]">🌐 YT Music</a>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Shared In-Browser Embedded Live Player Drawer -->
              <div id="in-browser-player-box" class="p-3.5 rounded-xl bg-[#0a0b12] border border-purple-500/40 hidden space-y-3 shadow-2xl">
                <div class="flex items-center justify-between text-xs text-purple-300 font-bold border-b border-purple-500/20 pb-2">
                  <span id="player-track-title" class="flex items-center gap-1.5">
                    <span>🎵</span> Now Playing in Browser...
                  </span>
                  <div class="flex items-center gap-3">
                    <a id="external-yt-link" href="#" target="_blank" rel="noopener noreferrer" class="text-[10px] px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 hover:text-white transition">🌐 Open YT Music</a>
                    <button id="close-player-btn" class="hover:text-purple-100 font-bold text-sm">✕</button>
                  </div>
                </div>

                <!-- IFrame Player Container -->
                <div class="relative w-full aspect-video rounded-lg overflow-hidden border border-purple-500/30 bg-black">
                  <iframe id="browser-player-iframe" class="w-full h-full" src="" title="Live In-Browser Music Player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
  </WorkspacePanel>
</section>

<script>
  // Music Playlist Drawer Toggle
  document.querySelectorAll('.music-artist-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.play-track-btn') || (e.target as HTMLElement).closest('a')) return;

      const target = card.getAttribute('data-target');
      if (!target) return;
      const drawer = document.getElementById(`playlist-${target}`);
      if (drawer) {
        drawer.classList.toggle('hidden');
      }
    });
  });

  // Live In-Browser Player Engine
  const playerBox = document.getElementById('in-browser-player-box');
  const playerIframe = document.getElementById('browser-player-iframe') as HTMLIFrameElement;
  const playerTitle = document.getElementById('player-track-title');
  const externalYtLink = document.getElementById('external-yt-link') as HTMLAnchorElement;
  const closePlayerBtn = document.getElementById('close-player-btn');

  document.querySelectorAll('.play-track-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const videoId = btn.getAttribute('data-video');
      const search = btn.getAttribute('data-search');
      const title = btn.getAttribute('data-title');

      if (videoId && playerIframe && playerBox) {
        // Standard YouTube embed URL (works across all regions)
        playerIframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        if (playerTitle) playerTitle.innerHTML = `🎵 Now Playing: <span class="text-white">${title}</span>`;
        if (externalYtLink && search) {
          externalYtLink.href = `https://music.youtube.com/search?q=${encodeURIComponent(search)}`;
        }
        playerBox.classList.remove('hidden');
        playerBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });

  closePlayerBtn?.addEventListener('click', () => {
    if (playerBox && playerIframe) {
      playerBox.classList.add('hidden');
      playerIframe.src = '';
    }
  });
</script>
