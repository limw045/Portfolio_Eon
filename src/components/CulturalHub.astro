<section id="culture" class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="text-center mb-16">
    <h2 class="text-3xl font-bold font-mono text-white mb-3" data-i18n="section_cult_title">✨ Cultural Tastes & Inspirations</h2>
    <p class="text-emerald-200/70 max-w-2xl mx-auto text-sm" data-i18n="section_cult_subtitle">Inspirations beyond code: Football tactics, R&B Groove, Sci-Fi, and competitive gaming</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="p-6 rounded-xl bg-black/60 border border-emerald-500/30 backdrop-blur-sm">
      <div class="text-3xl mb-3">⚽</div>
      <h3 class="text-xl font-bold font-mono text-white mb-2" data-i18n="cult_football_title">Football Pitch (Favorite Clubs)</h3>
      <p class="text-sm text-emerald-100/80 mb-4" data-i18n="cult_football_desc">Passionate about tactical precision, fluid passing, and execution excellence on the pitch — just like writing high-performance code.</p>
      <div class="flex flex-wrap gap-2 font-mono text-xs">
        <span class="px-3 py-1 rounded bg-amber-950/60 border border-amber-500/40 text-amber-300">Borussia Dortmund (BVB)</span>
        <span class="px-3 py-1 rounded bg-red-950/60 border border-red-500/40 text-red-300">Arsenal (Gunners)</span>
        <span class="px-3 py-1 rounded bg-cyan-950/60 border border-cyan-500/40 text-cyan-300">Manchester City</span>
      </div>
    </div>

    <div class="p-6 rounded-xl bg-black/60 border border-emerald-500/30 backdrop-blur-sm">
      <div class="text-3xl mb-3">🎵</div>
      <h3 class="text-xl font-bold font-mono text-white mb-2" data-i18n="cult_music_title">Music Groove (R&B & Soul)</h3>
      <p class="text-sm text-emerald-100/80 mb-4" data-i18n="cult_music_desc">Enthusiast of R&B, Soul, and Funk music by Khalil Fong, David Tao, and Bruno Mars. Rich harmonies drive coding focus.</p>
      <div class="flex flex-wrap gap-2 font-mono text-xs">
        <span class="px-3 py-1 rounded bg-purple-950/60 border border-purple-500/40 text-purple-300">Khalil Fong (方大同)</span>
        <span class="px-3 py-1 rounded bg-blue-950/60 border border-blue-500/40 text-blue-300">David Tao (陶喆)</span>
        <span class="px-3 py-1 rounded bg-pink-950/60 border border-pink-500/40 text-pink-300">Bruno Mars</span>
      </div>
    </div>
  </div>
</section>
