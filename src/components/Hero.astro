---
import WorkspacePanel from './WorkspacePanel.astro';
import { workspaceFiles } from '../data/workspace';

const file = workspaceFiles[0];
---

<section id="hero" data-section-key="hero" class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 flex flex-col items-center">
  
  <WorkspacePanel file={file} hero>
    <div id="vp-container" class="relative font-mono">

      <!-- Editor Content Body with Line Numbers -->
      <div class="p-6 sm:p-10 flex gap-4 sm:gap-6 text-left">
        <!-- Line Numbers Column -->
        <div class="select-none text-emerald-500/30 text-xs sm:text-sm font-mono space-y-3 pt-1 text-right w-6 sm:w-8 flex-shrink-0">
          <div>01</div>
          <div>02</div>
          <div>03</div>
          <div>04</div>
          <div>05</div>
          <div>06</div>
          <div>07</div>
        </div>

        <!-- Markdown Code Content -->
        <div class="flex-1 min-w-0">
          <!-- Line 1: Status Badge comment -->
          <div class="text-xs sm:text-sm text-emerald-500/70 mb-3 font-mono">
            <span class="text-emerald-400 font-bold">// STATUS:</span> <span class="px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 inline-block">AI Graduate @ MMU | CGPA 3.74</span>
          </div>

          <!-- Line 2 & 3: H1 VariableProximity Title -->
          <p class="hero-name">Lim Wei Jian</p>
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 leading-tight select-none cursor-default font-['Roboto_Flex']">
            <span class="text-emerald-500 font-mono font-normal mr-2 text-xl sm:text-3xl">#</span>
            <span class="vp-word text-white inline-block whitespace-nowrap" data-word="Full-Stack">Full-Stack</span>{" "}
            <span class="vp-word text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-500 font-extrabold inline-block whitespace-nowrap" data-word="Developer">Developer</span>{" "}
            <br class="hidden sm:inline" />
            <span class="vp-word text-white inline-block whitespace-nowrap" data-word="with">with</span>{" "}
            <span class="vp-word text-white inline-block whitespace-nowrap" data-word="a">a</span>{" "}
            <span class="vp-word text-white inline-block whitespace-nowrap" data-word="Deep">Deep</span>{" "}
            <span class="vp-word text-white inline-block whitespace-nowrap" data-word="Passion">Passion</span>{" "}
            <span class="vp-word text-white inline-block whitespace-nowrap" data-word="for">for</span>{" "}
            <span class="vp-word text-amber-400 font-extrabold inline-block whitespace-nowrap" data-word="AI">AI</span>
          </h1>

          <!-- Line 4 & 5: Quote / Desc Block -->
          <div class="border-l-2 border-emerald-500/40 pl-4 py-1 mb-8 text-emerald-200/90 text-sm sm:text-base font-sans leading-relaxed">
            <p>
              AI Graduate from MMU building useful full-stack products and intelligent systems with C++, Python, and TypeScript.
            </p>
          </div>

          <!-- Line 6: Interactive IDE Actions -->
          <div class="flex flex-wrap items-center gap-4 font-mono text-xs sm:text-sm pt-2">
            <button type="button" class="primary-button" data-contact-open>
              ✉ Contact Me
            </button>
            <a href="#skill-studio" class="secondary-button">
              ▶ Explore Skill Studio
            </a>
          </div>
        </div>
      </div>
    </div>
  </WorkspacePanel>
</section>

<script>
  // VariableProximity Algorithm for Roboto Flex Variable Font
  const container = document.getElementById('vp-container');
  const words = document.querySelectorAll('.vp-word');
  const radius = 120; // proximity radius in px

  words.forEach(word => {
    const text = word.textContent || '';
    word.innerHTML = '';
    text.split('').forEach(char => {
      const span = document.createElement('span');
      span.className = 'vp-letter inline-block transition-transform duration-75';
      span.style.fontVariationSettings = "'wght' 400, 'opsz' 9";
      span.textContent = char;
      word.appendChild(span);
    });
  });

  const letters = document.querySelectorAll('.vp-letter');
  let mouseX = -999;
  let mouseY = -999;

  window.addEventListener('mousemove', (e) => {
    if (!container) return;
    const rect = container.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
  });

  function animateProximity() {
    if (container) {
      const containerRect = container.getBoundingClientRect();

      letters.forEach(letter => {
        const el = letter as HTMLElement;
        const rect = el.getBoundingClientRect();
        const letterX = rect.left + rect.width / 2 - containerRect.left;
        const letterY = rect.top + rect.height / 2 - containerRect.top;

        const dist = Math.sqrt((mouseX - letterX) ** 2 + (mouseY - letterY) ** 2);

        if (dist < radius) {
          const norm = 1 - dist / radius;
          const wght = Math.round(400 + norm * 600);
          const opsz = Math.round(9 + norm * 31);
          el.style.fontVariationSettings = `'wght' ${wght}, 'opsz' ${opsz}`;
        } else {
          el.style.fontVariationSettings = "'wght' 400, 'opsz' 9";
        }
      });
    }
    requestAnimationFrame(animateProximity);
  }

  requestAnimationFrame(animateProximity);
</script>
