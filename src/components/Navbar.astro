---
---

<!-- High-End Floating Glass Pill Navbar (Linear / Apple Tier) -->
<header class="sticky top-4 z-50 max-w-5xl mx-auto px-4 w-full">
  <div class="rounded-full bg-[#0a0b12]/80 backdrop-blur-2xl border border-emerald-500/30 px-5 py-2.5 shadow-[0_10px_35px_rgba(0,0,0,0.8)] flex items-center justify-between font-mono text-xs text-emerald-300 transition duration-300 hover:border-emerald-500/50">
    
    <!-- Left: Brand Logo Pill -->
    <a href="#" class="font-bold text-emerald-400 hover:text-emerald-300 transition flex items-center gap-2 text-sm">
      <span class="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-extrabold text-[11px] flex items-center justify-center">⚡</span>
      <span>Lim Wei Jian</span>
    </a>

    <!-- Center: Navigation Links -->
    <nav class="hidden md:flex items-center gap-5 text-xs">
      <a href="#hero" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_story">Origin Story</a>
      <a href="#academic" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_academic">Academic Journey</a>
      <a href="#culture" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_culture">Cultural Hub</a>
      <a href="#skill-studio" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_skills">Skill Studio</a>
      <a href="#micro-tools" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_tools">Micro-Tools</a>
    </nav>

    <!-- Right: Theme, Matrix Rain, Language Toggle Pill -->
    <div class="flex items-center gap-2 text-xs">
      
      <!-- Quick Matrix Rain Toggle Button -->
      <button id="quick-matrix-btn" class="px-2.5 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-900/60 transition text-[11px] flex items-center gap-1 font-bold">
        <span>🟢</span> <span class="hidden sm:inline">Rain</span>
      </button>

      <!-- 5 Themes Selector Dropdown -->
      <div class="relative group">
        <button class="px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-900/60 transition text-[11px] flex items-center gap-1 font-bold">
          🎨 Theme ▾
        </button>
        <div class="absolute right-0 mt-2 w-48 py-2 rounded-xl bg-[#090a10]/95 border border-emerald-500/40 shadow-2xl opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition duration-200 z-50 backdrop-blur-xl">
          <div class="px-4 py-1 text-[10px] font-bold text-emerald-400/60 uppercase">🎨 5 Master Themes</div>
          <button data-theme-target="ide" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-emerald-300 transition">💻 IDE Cyber Code</button>
          <button data-theme-target="football" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-amber-300 transition">⚽ Football Pitch</button>
          <button data-theme-target="cinema" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-yellow-400 transition">🎬 Cinema Noir</button>
          <button data-theme-target="swiss" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-red-400 transition">📜 Swiss Editorial</button>
          <button data-theme-target="travel" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-orange-300 transition">✈️ Travel Story Log</button>
        </div>
      </div>

      <!-- Language Toggle -->
      <button id="lang-btn" class="px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-900/60 transition text-[11px] font-bold">
        🌐 EN / 中文
      </button>

      <!-- Sidebar Toggle -->
      <button id="sidebar-pill-btn" class="px-2.5 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-900/60 transition text-[11px] font-bold">
        📂
      </button>
    </div>
  </div>
</header>

<script>
  import { dictionaries, type Language } from '../scripts/i18n';

  let currentLang: Language = 'en';

  function updateLanguage(lang: Language) {
    currentLang = lang;
    document.documentElement.lang = lang;
    const dict = dictionaries[lang];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n') as keyof typeof dict;
      if (key && dict[key]) {
        el.innerHTML = dict[key];
      }
    });
  }

  document.getElementById('lang-btn')?.addEventListener('click', () => {
    updateLanguage(currentLang === 'en' ? 'zh' : 'en');
  });

  // 5 Theme Switching Listener
  document.querySelectorAll('[data-theme-target]').forEach(btn => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme-target');
      if (theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('weijian_portfolio_theme', theme);
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
      }
    });
  });

  // Quick Matrix Rain Toggle
  document.getElementById('quick-matrix-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('matrixmode'));
  });

  // Sidebar Toggle
  document.getElementById('sidebar-pill-btn')?.addEventListener('click', () => {
    const sidebar = document.getElementById('ide-sidebar');
    if (sidebar) {
      sidebar.classList.toggle('-translate-x-full');
    }
  });

  // Restore saved theme on load
  const savedTheme = localStorage.getItem('weijian_portfolio_theme') || 'ide';
  document.documentElement.setAttribute('data-theme', savedTheme);
</script>
