---
---

<!-- Single Unified VS Code Header -->
<header class="sticky top-0 z-50 bg-[#12131c]/90 backdrop-blur-md border-b border-emerald-500/30 text-xs font-mono text-emerald-300">
  <div class="max-w-7xl mx-auto px-4 h-12 flex items-center justify-between">
    <!-- Left Section: VS Code Branding & Dropdowns -->
    <div class="flex items-center gap-3">
      <a href="#" class="font-bold text-emerald-400 hover:text-emerald-300 transition flex items-center gap-1.5 text-sm">
        <span>⚡</span> Lim Wei Jian
      </a>

      <div class="hidden sm:flex items-center gap-2 text-[11px] text-emerald-300/80">
        <span class="hover:text-emerald-200 cursor-pointer">File</span>
        <span class="hover:text-emerald-200 cursor-pointer">Edit</span>
        
        <!-- View Menu Dropdown -->
        <div class="relative group">
          <button class="hover:text-emerald-200 cursor-pointer text-emerald-300 font-bold">View ▾</button>
          <div class="absolute left-0 mt-1 w-52 py-2 rounded bg-black/95 border border-emerald-500/40 shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition z-50">
            <div class="px-4 py-1 text-[10px] font-bold text-emerald-400/60 uppercase">🎨 Color Themes</div>
            <button data-theme-target="ide" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-emerald-300">💻 IDE Cyber Code</button>
            <button data-theme-target="football" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-amber-300">⚽ Green Pitch (Football)</button>
            <button data-theme-target="cinema" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-yellow-400">🎬 Cinema Noir</button>
            <button data-theme-target="swiss" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-red-400">📜 Swiss Editorial</button>
            <button data-theme-target="travel" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-orange-300">✈️ Travel Story Log</button>
            <div class="my-1 border-t border-emerald-500/20"></div>
            <button id="menu-matrix-toggle" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-emerald-300">
              🟢 Toggle Matrix Rain <span class="float-right text-[10px] opacity-60">Ctrl+Alt+M</span>
            </button>
            <button id="menu-toggle-sidebar" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-emerald-300">
              📂 Toggle Explorer <span class="float-right text-[10px] opacity-60">Ctrl+B</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Center Section: Navigation Links -->
    <nav class="hidden lg:flex items-center gap-5 text-xs">
      <a href="#hero" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_story">Origin Story</a>
      <a href="#academic" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_academic">Academic Journey</a>
      <a href="#culture" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_culture">Cultural Hub</a>
      <a href="#skill-studio" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_skills">Skill Studio</a>
      <a href="#micro-tools" class="text-emerald-200/80 hover:text-emerald-400 transition" data-i18n="nav_tools">Micro-Tools</a>
    </nav>

    <!-- Right Section: Language, Theme Dropdown & Window Buttons -->
    <div class="flex items-center gap-3 text-xs">
      <!-- Theme Switcher Quick Button -->
      <div class="relative group">
        <button class="px-2.5 py-1 rounded bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-900/60 transition text-[11px]">
          🎨 Theme ▾
        </button>
        <div class="absolute right-0 mt-1 w-44 py-2 rounded bg-black/95 border border-emerald-500/40 shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition z-50">
          <button data-theme-target="ide" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-emerald-300">💻 IDE Cyber Code</button>
          <button data-theme-target="football" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-amber-300">⚽ Football</button>
          <button data-theme-target="cinema" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-yellow-400">🎬 Cinema Noir</button>
          <button data-theme-target="swiss" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-red-400">📜 Swiss Editorial</button>
          <button data-theme-target="travel" class="w-full text-left px-4 py-1.5 hover:bg-emerald-950 text-orange-300">✈️ Travel Story Log</button>
        </div>
      </div>

      <!-- Language Toggle -->
      <button id="lang-btn" class="px-2.5 py-1 rounded bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-900/60 transition text-[11px]">
        🌐 EN / 中文
      </button>

      <span class="text-emerald-400 text-[11px] hidden sm:inline"> main*</span>

      <div class="hidden sm:flex items-center gap-1 text-emerald-400/70 text-[10px]">
        <span class="px-1 hover:bg-emerald-950 cursor-pointer">―</span>
        <span class="px-1 hover:bg-emerald-950 cursor-pointer">□</span>
        <span class="px-1 hover:bg-red-950 hover:text-red-400 cursor-pointer">✕</span>
      </div>
    </div>
  </div>
</header>

<script>
  import { dictionaries, type Language } from '../scripts/i18n';

  let currentLang: Language = 'en';

  function updateLanguage(lang: Language) {
    currentLang = lang;
    document.documentElement.lang = lang;
    const dict = dictionaries[lang];
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n') as keyof typeof dict;
      if (key && dict[key]) {
        el.innerHTML = dict[key];
      }
    });
  }

  document.getElementById('lang-btn')?.addEventListener('click', () => {
    updateLanguage(currentLang === 'en' ? 'zh' : 'en');
  });

  // 5 Theme Switching Listener
  document.querySelectorAll('[data-theme-target]').forEach(btn => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme-target');
      if (theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('weijian_portfolio_theme', theme);
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
      }
    });
  });

  // Top Menu Actions
  document.getElementById('menu-matrix-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('matrixmode'));
  });

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'm') {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('matrixmode'));
    }
  });

  // Restore saved theme on load
  const savedTheme = localStorage.getItem('weijian_portfolio_theme') || 'ide';
  document.documentElement.setAttribute('data-theme', savedTheme);
</script>
