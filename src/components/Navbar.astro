---
import { workspaceFiles } from '../data/workspace';
---

<header class="command-bar-wrap">
  <div class="command-bar" role="navigation" aria-label="Portfolio workspace">
    <a href="#hero" class="command-bar__brand" aria-label="Lim Wei Jian, go to introduction">
      <span aria-hidden="true">⚡</span><strong>Lim Wei Jian</strong>
    </a>

    <div class="command-bar__files">
      <button id="file-menu-trigger" class="command-bar__current" type="button" aria-expanded="false" aria-controls="file-menu">
        <span id="current-file-icon" aria-hidden="true">📝</span>
        <span id="current-file-name" class="current-file-long">01_origin_story.md</span>
        <span id="current-file-short" class="current-file-short">origin.md</span>
        <span aria-hidden="true">⌄</span>
      </button>
      <div id="file-menu" class="command-menu command-menu--files" hidden>
        <div class="command-menu__label">OPEN FILE</div>
        {workspaceFiles.map((file) => (
          <a href={`#${file.id}`} data-workspace-link={file.id}>
            <span aria-hidden="true">{file.icon}</span>
            <span><strong>{file.filename}</strong><small>workspace/{file.workspacePath} · {file.fileType}</small></span>
          </a>
        ))}
      </div>
    </div>

    <div class="command-bar__actions">
      <button class="command-action command-action--contact" type="button" data-contact-open aria-label="Open contact panel">
        <span aria-hidden="true">✉</span><span>Contact</span>
      </button>
      <div class="command-bar__theme">
        <button id="theme-menu-trigger" class="command-action command-action--icon" type="button" aria-label="Choose theme" aria-expanded="false" aria-controls="theme-menu">🎨</button>
        <div id="theme-menu" class="command-menu command-menu--themes" hidden>
          <div class="command-menu__label">COLOR THEME</div>
          <button data-theme-target="ide"><span>IDE Cyber Code</span><small class="theme-ready">Available</small></button>
          <button data-theme-target="football"><span>⚽ Football Pitch</span><small>Preview / WIP</small></button>
          <button data-theme-target="cinema"><span>Cinema Noir</span><small class="theme-ready">Available</small></button>
          <button data-theme-target="swiss"><span>📜 Swiss Editorial</span><small>Preview / WIP</small></button>
          <button data-theme-target="travel"><span>✈️ Travel Story Log</span><small>Preview / WIP</small></button>
          <div class="command-menu__note">IDE and Cinema are complete stages. Other themes remain visual previews.</div>
        </div>
      </div>
      <button id="quick-matrix-btn" class="command-action command-action--icon command-action--desktop" type="button" aria-label="Toggle code rain">◉</button>
      <button id="command-terminal-btn" class="command-action command-action--icon" type="button" aria-label="Open terminal" aria-expanded="false">›_</button>
      <button id="sidebar-pill-btn" class="command-action command-action--icon" type="button" aria-label="Open workspace explorer" aria-expanded="false">☷</button>
    </div>
  </div>
</header>

<script>
  import { workspaceFiles } from '../data/workspace';

  const fileTrigger = document.getElementById('file-menu-trigger');
  const fileMenu = document.getElementById('file-menu');
  const themeTrigger = document.getElementById('theme-menu-trigger');
  const themeMenu = document.getElementById('theme-menu');

  function toggleMenu(trigger: HTMLElement | null, menu: HTMLElement | null, force?: boolean) {
    if (!trigger || !menu) return;
    const open = force ?? menu.hidden;
    menu.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
  }

  fileTrigger?.addEventListener('click', () => {
    toggleMenu(fileTrigger, fileMenu);
    toggleMenu(themeTrigger, themeMenu, false);
  });
  themeTrigger?.addEventListener('click', () => {
    toggleMenu(themeTrigger, themeMenu);
    toggleMenu(fileTrigger, fileMenu, false);
  });
  fileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => toggleMenu(fileTrigger, fileMenu, false)));

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!fileTrigger?.contains(target) && !fileMenu?.contains(target)) toggleMenu(fileTrigger, fileMenu, false);
    if (!themeTrigger?.contains(target) && !themeMenu?.contains(target)) toggleMenu(themeTrigger, themeMenu, false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      toggleMenu(fileTrigger, fileMenu, false);
      toggleMenu(themeTrigger, themeMenu, false);
    }
  });

  themeMenu?.querySelectorAll('[data-theme-target]').forEach((button) => button.addEventListener('click', () => toggleMenu(themeTrigger, themeMenu, false)));

  document.getElementById('quick-matrix-btn')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('matrixmode')));
  document.getElementById('command-terminal-btn')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('terminaltoggle')));
  document.getElementById('sidebar-pill-btn')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('explorertoggle')));

  const currentName = document.getElementById('current-file-name');
  const currentShort = document.getElementById('current-file-short');
  const currentIcon = document.getElementById('current-file-icon');
  const sections = workspaceFiles.map((file) => ({ file, element: document.getElementById(file.id) })).filter((item) => item.element);
  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (!visible) return;
    const file = workspaceFiles.find((item) => item.id === visible.target.id);
    if (!file) return;
    if (currentName) currentName.textContent = file.filename;
    if (currentShort) currentShort.textContent = file.shortFilename;
    if (currentIcon) currentIcon.textContent = file.icon;
    document.querySelectorAll('[data-workspace-link]').forEach((link) => link.toggleAttribute('aria-current', link.getAttribute('data-workspace-link') === file.id));
  }, { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.1, 0.35] });
  sections.forEach(({ element }) => element && observer.observe(element));
</script>
