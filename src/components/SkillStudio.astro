</section>

<script>
  const codeTabs = document.querySelectorAll('.code-tab-btn');
  const codeSnippets = document.querySelectorAll('.code-snippet');
  const runBtn = document.getElementById('run-code-btn');
  const termOut = document.getElementById('ide-terminal-output');
  let currentActiveTab = 'cpp';

  codeTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      if (!target) return;
      currentActiveTab = target;

      codeTabs.forEach(b => {
        b.className = 'code-tab-btn px-3 py-1.5 rounded-lg text-blue-300/70 hover:bg-blue-950 transition flex items-center gap-1.5';
      });
      tab.className = 'code-tab-btn px-3 py-1.5 rounded-lg bg-blue-600 text-white font-bold transition flex items-center gap-1.5';

      codeSnippets.forEach(s => s.classList.add('hidden'));
      const activeSnippet = document.getElementById(`code-${target}`);
      if (activeSnippet) activeSnippet.classList.remove('hidden');
    });
  });

  runBtn?.addEventListener('click', () => {
    if (!termOut) return;
    termOut.innerHTML = '⚙️ Compiling kernel target...<br>';

    setTimeout(() => {
      if (currentActiveTab === 'cpp') {
        termOut.innerHTML = '&gt;&gt; g++ -O3 -std=c++20 solution.cpp -o solution<br>[C++20 Thread #0] High-performance matrix kernel computed.<br><span class="text-emerald-400">✓ Process finished with exit code 0 (12ms)</span>';
      } else if (currentActiveTab === 'python') {
        termOut.innerHTML = '&gt;&gt; python3 solution.py<br>&gt;&gt; PyTorch 2.4.0 active on device: cuda:0 (NVIDIA RTX 4080)<br>YOLOv8 Object Detection Tensor initialized.<br><span class="text-emerald-400">✓ Process finished with exit code 0 (18ms)</span>';
      } else if (currentActiveTab === 'java') {
        termOut.innerHTML = '&gt;&gt; java -jar target/skill-app-1.0.0.jar<br>&gt;&gt; Starting Spring Boot Microservice Container...<br>Started SkillApplication in 0.842 seconds (JVM running for 1.2)<br><span class="text-emerald-400">✓ Process finished with exit code 0</span>';
      } else if (currentActiveTab === 'cs') {
        termOut.innerHTML = '&gt;&gt; dotnet run --configuration Release<br>&gt;&gt; .NET 8.0 Async LINQ Stream Engine Initialized.<br><span class="text-emerald-400">✓ Build succeeded. 0 Warning(s), 0 Error(s).</span>';
      }
    }, 400);
  });
</script>
