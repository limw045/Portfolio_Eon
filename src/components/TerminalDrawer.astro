---
---

<!-- Integrated VS Code Terminal Drawer (Bottom Dock) -->
<div id="ide-terminal-drawer" class="fixed bottom-7 left-0 right-0 z-40 bg-[#090a10]/95 border-t border-emerald-500/30 transition-all duration-300 transform translate-y-full max-h-[300px] flex flex-col shadow-[0_-10px_40px_rgba(0,0,0,0.9)] font-mono text-xs backdrop-blur-2xl">
  <!-- Terminal Header Bar -->
  <div class="flex items-center justify-between px-4 py-2 bg-[#10121d] border-b border-emerald-500/20 text-xs">
    <div class="flex items-center gap-2 sm:gap-3 overflow-x-auto">
      <button class="px-3 py-1 rounded-md bg-emerald-500 text-black font-bold flex items-center gap-1.5 shadow">
        <span>💻</span> TERMINAL
      </button>
      <button class="px-3 py-1 rounded-md hover:bg-emerald-950/60 text-emerald-300/70 transition flex items-center gap-1.5">
        <span>⚙️</span> OUTPUT
      </button>
      <button class="px-3 py-1 rounded-md hover:bg-emerald-950/60 text-emerald-300/70 transition flex items-center gap-1.5">
        <span>🔍</span> PROBLEMS <span class="px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 text-[10px]">0</span>
      </button>
      <button class="px-3 py-1 rounded-md hover:bg-emerald-950/60 text-emerald-300/70 transition flex items-center gap-1.5 hidden sm:flex">
        <span>🐛</span> DEBUG CONSOLE
      </button>
    </div>
    
    <div class="flex items-center gap-3 text-emerald-400/80 text-xs flex-shrink-0">
      <span class="hidden md:inline text-[11px] text-emerald-300/60">Type '<span class="text-emerald-400 font-bold">help</span>' for commands</span>
      <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[11px] font-bold border border-emerald-500/30">🟢 zsh</span>
      <button id="close-terminal-btn" class="hover:text-emerald-200 text-sm font-bold px-1">✕</button>
    </div>
  </div>

  <!-- CLI Terminal Output Body -->
  <div id="terminal-cli-body" class="flex-1 p-4 overflow-y-auto font-mono text-xs space-y-1.5 text-emerald-300 bg-[#06070b]/90 leading-relaxed">
    <div class="text-emerald-400 font-bold">&gt;&gt; Lim Wei Jian Interactive Workstation Terminal v2026.8.3</div>
    <div class="text-emerald-200/80">Type '<span class="text-emerald-400 font-bold">help</span>' for commands or '<span class="text-emerald-400 font-bold">matrix</span>' to trigger code rain.</div>
  </div>

  <!-- CLI Command Input Line -->
  <div class="flex items-center px-4 py-2.5 bg-[#090a10] border-t border-emerald-500/20">
    <span class="text-emerald-400 font-bold mr-2 text-xs sm:text-sm flex-shrink-0">weijian@mmu-ai-node:~$</span>
    <input
      type="text"
      id="terminal-cli-input"
      placeholder="Type command (help, skills, cat resume, matrix, clear)..."
      class="flex-1 bg-transparent border-none text-white font-mono text-xs sm:text-sm focus:outline-none placeholder:text-emerald-500/40"
      autocomplete="off"
    />
  </div>
</div>

<!-- Fixed VS Code Bottom Status Bar (Height 28px, z-index 50) -->
<footer class="fixed bottom-0 left-0 right-0 z-50 h-7 bg-[#08090f] border-t border-emerald-500/30 flex items-center justify-between px-4 font-mono text-[11px] text-emerald-300 backdrop-blur-md">
  <div class="flex items-center gap-3 sm:gap-5">
    <button id="toggle-terminal-btn" class="flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-emerald-600/90 text-white font-bold hover:bg-emerald-500 transition shadow">
      <span>💻</span> Terminal
    </button>
    <span class="flex items-center gap-1 text-emerald-300/80">
      <span class="text-amber-400"></span> main*
    </span>
    <span class="text-emerald-400 flex items-center gap-1">
      <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> 0 Errors, 0 Warnings
    </span>
  </div>

  <div class="hidden sm:flex items-center gap-4 text-emerald-400/60">
    <span>Ln 42, Col 1</span>
    <span>Spaces: 2</span>
    <span>UTF-8</span>
    <span>Python 3.12</span>
    <span class="text-emerald-400 font-bold">Prettier ✓</span>
  </div>
</footer>

<script>
  const drawer = document.getElementById('ide-terminal-drawer');
  const toggleBtn = document.getElementById('toggle-terminal-btn');
  const closeBtn = document.getElementById('close-terminal-btn');
  const cliInput = document.getElementById('terminal-cli-input') as HTMLInputElement;
  const cliBody = document.getElementById('terminal-cli-body');

  let isOpen = false;

  function toggleTerminal() {
    isOpen = !isOpen;
    if (drawer) {
      if (isOpen) {
        drawer.classList.remove('translate-y-full');
        cliInput?.focus();
      } else {
        drawer.classList.add('translate-y-full');
      }
    }
  }

  toggleBtn?.addEventListener('click', toggleTerminal);
  closeBtn?.addEventListener('click', toggleTerminal);

  // CLI Command Engine
  cliInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const cmd = cliInput.value.trim().toLowerCase();
      cliInput.value = '';
      if (!cmd || !cliBody) return;

      cliBody.innerHTML += `<div><span class="text-emerald-400 font-bold">weijian@mmu-ai-node:~$</span> ${cmd}</div>`;

      if (cmd === 'help') {
        cliBody.innerHTML += `
          <div class="text-emerald-200/80">Available commands:</div>
          <div class="pl-4 text-emerald-300">
            • <span class="font-bold text-amber-300">skills</span> - Display AI & Full-Stack tech stack<br>
            • <span class="font-bold text-amber-300">matrix</span> - Trigger Matrix code rain<br>
            • <span class="font-bold text-amber-300">cat resume</span> - Print resume summary<br>
            • <span class="font-bold text-amber-300">clear</span> - Clear terminal screen<br>
            • <span class="font-bold text-amber-300">help</span> - Show this help menu
          </div>`;
      } else if (cmd === 'skills') {
        cliBody.innerHTML += `
          <div class="text-emerald-300">
            [AI Stack]: Multi-Agent RAG, LangChain, LlamaIndex, YOLO, ResNet, PyTorch, Python<br>
            [Full-Stack]: Astro, TypeScript, React, Tailwind CSS, C++, C#, Java, PHP, MySQL, Cloudflare Pages
          </div>`;
      } else if (cmd === 'matrix') {
        cliBody.innerHTML += `<div class="text-emerald-400 font-bold">Wake up, Neo... The Matrix has you. 🐇</div>`;
        window.dispatchEvent(new CustomEvent('matrixmode'));
      } else if (cmd === 'cat resume') {
        cliBody.innerHTML += `
          <div class="text-emerald-300">
            Lim Wei Jian | AI Graduate @ MMU | CGPA 3.74<br>
            Specialized in Multi-Agent RAG & Full-Stack Systems.<br>
            Degree FYP: JKR-Compliant TIA Generator (+70% efficiency).
          </div>`;
      } else if (cmd === 'clear') {
        cliBody.innerHTML = '';
      } else {
        cliBody.innerHTML += `<div class="text-red-400">Command not found: ${cmd}. Type 'help' for available commands.</div>`;
      }

      cliBody.scrollTop = cliBody.scrollHeight;
    }
  });
</script>
