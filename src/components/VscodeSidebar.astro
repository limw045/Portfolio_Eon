---

<!-- Authentic VS Code Integrated Sidebar with Activity Bar -->
<aside id="ide-sidebar" class="fixed top-20 left-4 bottom-10 w-72 bg-[#090a10]/95 backdrop-blur-2xl border border-emerald-500/30 rounded-xl z-40 transition-transform duration-300 transform -translate-x-[calc(100%+2rem)] shadow-[0_20px_50px_rgba(0,0,0,0.9)] font-mono text-xs text-emerald-300 overflow-hidden flex" aria-label="Workspace explorer" aria-hidden="true" inert>
  
  <!-- Activity Bar (Far Left 48px) -->
  <div class="w-12 bg-[#06070a] border-r border-emerald-500/20 flex flex-col items-center py-4 justify-between text-base">
    <div class="space-y-4 text-emerald-400/60">
      <button class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-300 flex items-center justify-center border border-emerald-500/40" title="Explorer">📂</button>
      <button class="w-8 h-8 rounded-lg hover:bg-emerald-950 text-emerald-400/60 hover:text-emerald-300 flex items-center justify-center transition" title="Search">🔍</button>
      <button class="w-8 h-8 rounded-lg hover:bg-emerald-950 text-emerald-400/60 hover:text-emerald-300 flex items-center justify-center transition" title="Source Control"></button>
      <button class="w-8 h-8 rounded-lg hover:bg-emerald-950 text-emerald-400/60 hover:text-emerald-300 flex items-center justify-center transition" title="Run and Debug">🐞</button>
      <button class="w-8 h-8 rounded-lg hover:bg-emerald-950 text-emerald-400/60 hover:text-emerald-300 flex items-center justify-center transition" title="Extensions">🧩</button>
    </div>
    <div class="text-xs text-emerald-500/40">⚙️</div>
  </div>

  <!-- Main Explorer Tree Panel -->
  <div class="flex-1 flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 bg-[#0d0e16] border-b border-emerald-500/20 font-bold text-emerald-400">
      <span>EXPLORER: PORTFOLIO</span>
      <button id="sidebar-close-btn" class="hover:text-emerald-200 font-bold text-sm">✕</button>
    </div>
    
    <!-- Tree Content -->
    <div class="p-4 flex-1 overflow-y-auto space-y-3">
      <div class="font-bold text-emerald-400 flex items-center gap-1.5 text-xs">
        <span class="text-amber-400">📁</span> src/workspace/
      </div>
      <ul class="pl-4 space-y-2 text-emerald-200/80 text-xs">
        <li class="hover:text-emerald-400 transition"><a href="#hero" class="block py-1">📄 01_origin_story.md</a></li>
        <li class="hover:text-emerald-400 transition"><a href="#academic" class="block py-1">📄 02_academic_journey.json</a></li>
        <li class="hover:text-emerald-400 transition"><a href="#culture" class="block py-1">📄 03_culture_hub.config</a></li>
        <li class="hover:text-emerald-400 transition"><a href="#skill-studio" class="block py-1">📄 04_skill_studio.cpp</a></li>
        <li class="hover:text-emerald-400 transition"><a href="#n8n-studio" class="block py-1">📄 05_n8n_workflow.py</a></li>
        <li class="hover:text-emerald-400 transition"><a href="#micro-tools" class="block py-1">📄 06_micro_tools.css</a></li>
      </ul>

      <div class="pt-4 border-t border-emerald-500/15">
        <div class="text-[10px] font-bold text-emerald-400/50 uppercase tracking-wider mb-2">Workspace Stats</div>
        <div class="text-[11px] text-emerald-300/70 space-y-1">
          <div>• Active Branch: <span class="text-emerald-400 font-bold">main</span></div>
          <div>• System: <span class="text-emerald-400">Astro SSG</span></div>
          <div>• Status: <span class="text-emerald-400">Deployed</span></div>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('ide-sidebar');
  const closeBtn = document.getElementById('sidebar-close-btn');
  const sidebarTrigger = document.getElementById('sidebar-pill-btn');

  function setExplorer(open: boolean) {
    sidebar?.classList.toggle('-translate-x-[calc(100%+2rem)]', !open);
    sidebar?.setAttribute('aria-hidden', String(!open));
    sidebar?.toggleAttribute('inert', !open);
    sidebarTrigger?.setAttribute('aria-expanded', String(open));
    if (open) closeBtn?.focus();
    else sidebarTrigger?.focus();
  }

  closeBtn?.addEventListener('click', () => {
    setExplorer(false);
  });
  window.addEventListener('explorertoggle', () => setExplorer(sidebar?.getAttribute('aria-hidden') === 'true'));
  sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    setExplorer(false);
    const target = document.querySelector<HTMLElement>(link.getAttribute('href') || '');
    window.setTimeout(() => {
      const heading = target?.querySelector<HTMLElement>('h1, h2');
      if (!heading) return;
      heading.setAttribute('tabindex', '-1');
      heading.focus({ preventScroll: true });
    }, 350);
  }));

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key.toLowerCase() === 'b') {
      e.preventDefault();
      setExplorer(sidebar?.getAttribute('aria-hidden') === 'true');
    }
    if (e.key === 'Escape' && sidebar?.getAttribute('aria-hidden') === 'false') setExplorer(false);
  });
</script>
